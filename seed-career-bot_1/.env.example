# ========================================
# TELEGRAM BOT CONFIGURATION
# ========================================

# 🔐 BOT TOKEN (Get from @BotFather)
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 🤖 DEEPSEEK AI CONFIGURATION
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
ENABLE_AI=true
AI_MODE=controlled  # controlled | free | disabled
MAX_AI_REQUESTS_PER_USER=50
AI_TEMPERATURE=0.7

# 👥 ADMINISTRATION
ADMIN_IDS=123456789,987654321  # Comma-separated Telegram user IDs

# 🚀 SERVER CONFIGURATION
PORT=3000
NODE_ENV=production
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com

# 📊 DATABASE (Optional)
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/db
# REDIS_URL=redis://localhost:6379

# ⚡ PERFORMANCE
MAX_CONCURRENT_JOBS=5
REQUEST_TIMEOUT=30000

# 📝 LOGGING
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# ========================================
# INSTRUCTIONS:
# 1. Copy this file to `.env`
# 2. Fill in your actual values
# 3. NEVER commit `.env` to Git!
# ========================================
# ===== FACEBOOK MESSENGER =====
FACEBOOK_PAGE_TOKEN=EAA... (Page Access Token từ Facebook)
FACEBOOK_VERIFY_TOKEN=seed-career-verify-2024
FACEBOOK_APP_SECRET=your_app_secret